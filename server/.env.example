# Copy this file to server/.env and fill in the values. Never commit .env.
PORT=5000
# MongoDB Atlas connection string, e.g. mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/holdmate?retryWrites=true&w=majority
MONGODB_URI=
# Long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
NODE_ENV=development
HUB_LAT=10.9965
HUB_LNG=76.9667
SERVICE_RADIUS_KM=15
# Optional: extra frontend origins allowed to call the API with cookies (comma-separated),
# e.g. when the frontend runs on VS Code Live Server instead of http://localhost:5000
# CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# ---- SMS / login OTP provider ----
# console (default when empty) = print the OTP in the server terminal (development only)
# messagecentral = Message Central VerifyNow | msg91 = MSG91 OTP API (needs DLT registration) | fast2sms = Fast2SMS
SMS_PROVIDER=
# Message Central (cpaas.messagecentral.com)
# Preferred: the ready Auth Token from console.messagecentral.com -> Developer Guide -> API Credentials
MC_AUTH_TOKEN=
# Fallback (used only if MC_AUTH_TOKEN is empty): Customer ID + Base64 of your Message Central password
MC_CUSTOMER_ID=
MC_KEY=
# MSG91 (control.msg91.com) - OTP template must be DLT-approved before production use
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Fast2SMS (fast2sms.com) - OTP route
FAST2SMS_API_KEY=
